#main-container {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

GameList {
    width: 50%;
    height: 100%;
    border: round $primary;
}

#game-count {
    padding: 1 2;
    text-style: bold;
    background: $surface;
    color: $accent;
    width: 100%;
    text-align: center;
}

#game-options {
    height: 1fr;
    border: none;
    background: transparent;
    color: $text;
}

#game-options DataTableColumn {
    overflow: hidden;
    text-overflow: ellipsis;
}

DataTable > .datatable--header {
    text-style: bold;
    color: $accent;
    background: $surface;
}


GameDetail {
    width: 50%;
    height: 100%;
    border: round $secondary;
    padding: 1 2;
}

/* Config Screen Styles */
ConfigurationScreen {
    align: center middle;
}

#config-dialog {
    width: 60%;
    height: auto;
    border: thick $background 80%;
    background: $surface;
    padding: 2 4;
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
    margin-bottom: 1;
}

#config-buttons {
    align: right middle;
    height: auto;
    margin-top: 2;
}

#config-buttons Button {
    margin-left: 2;
}

#status-bar {
    height: 1;
    background: $surface;
    color: $text;
    width: 100%;
    layout: horizontal;
    display: none;
}

#status-bar.active {
    display: block;
}

#status-message {
    width: 40%;
    padding: 0 1;
    text-overflow: ellipsis;
    color: $accent;
    text-style: bold;
}

#status-progress {
    width: 60%;
    height: 1;
}

#status-progress > .progress--bar {
    color: $accent;
    background: $surface;
}

/* Game Options Screen Styles */
GameOptionsScreen {
    align: center middle;
    background: $foreground 10%;
}

#game-options-dialog {
    width: 50;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

#game-options-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#game-options-buttons {
    align: center middle;
    height: auto;
    margin-top: 1;
}

#game-options-buttons Button {
    margin: 0 1;
}

/* Quit Confirmation Styles */
#quit-dialog {
    width: 40;
    height: auto;
    background: $surface;
    border: thick $error;
    padding: 1 2;
    align: center middle;
}

#quit-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
    text-style: bold;
}

#quit-buttons {
    align: center middle;
    height: auto;
}

#quit-buttons Button {
    margin: 1 2;
}

#library-count {
    dock: right;
    padding: 0 2;
}

/* Sorting, Filtering & Enrichers Screen Styles */
#sorting-dialog, #filtering-dialog, #input-dialog, #enrichers-dialog, #scoring-dialog {
    width: 45;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
    align: center middle;
}

#sorting-title, #filtering-title, #input-title, #enrichers-title, #scoring-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.sort-option, .filter-option, .enricher-option, .scoring-option {
    width: 100%;
    padding: 0 2;
    margin-bottom: 0;
}

#sorting-hint, #filtering-hint, #input-hint, #enrichers-hint, #scoring-hint {
    width: 100%;
    text-align: center;
    margin-top: 1;
    color: $text-muted;
}

#filter-input {
    margin: 1 0;
    border: tall $accent;
}

/* Reload Confirmation Styles */
#reload-dialog {
    width: 50;
    height: auto;
    background: $surface;
    border: thick $error;
    padding: 1 2;
    align: center middle;
}

#reload-title-warn {
    width: 100%;
    text-align: center;
    color: $error;
    text-style: bold;
    margin-bottom: 1;
}

#reload-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#reload-buttons {
    align: center middle;
    height: auto;
}

#reload-buttons Button {
    margin: 1 2;
}


/* Expanded Scoring Screen Styles */
ScoringScreen {
    align: center middle;
    background: $foreground 10%;
}

#scoring-dialog-expanded {
    width: 120;
    height: 40;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

#scoring-content {
    height: 1fr;
    width: 100%;
}

#scoring-list {
    width: 30%;
    height: 100%;
    border-right: solid $primary;
    background: $surface;
}

#scoring-list > ListItem {
    padding: 1 2;
}

#scoring-list > ListItem.--highlight {
    background: $accent;
    color: $text;
}

#scoring-info-panel {
    width: 70%;
    height: 100%;
    padding: 1 3;
}

#info-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    border-bottom: solid $accent;
}

#info-body {
    height: 1fr;
    color: $text;
}

/* Scoring Config Screen Styles */
ScoringConfigScreen {
    align: center middle;
    background: $foreground 10%;
}

#scoring-config-dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 2;
}

#config-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#config-form {
    height: auto;
    min-height: 20;
    border: solid $accent;
    margin: 1 0;
}

#config-form Label {
    margin: 0;
}

#config-form Input {
    margin-bottom: 0;
}

#genre-scroll {
    height: 15;
}

#config-buttons {
    margin-top: 1;
}

#config-buttons Button {
    margin-left: 1;
}
